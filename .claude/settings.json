{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "$CLAUDE_PROJECT_DIR/.venv/bin/tremula hook SessionStart" }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "$CLAUDE_PROJECT_DIR/.venv/bin/tremula hook UserPromptSubmit" }] }
    ],
    "PostToolUse": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "$CLAUDE_PROJECT_DIR/.venv/bin/tremula hook PostToolUse" }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "$CLAUDE_PROJECT_DIR/.venv/bin/tremula hook Stop" }] }
    ],
    "PreCompact": [
      { "hooks": [{ "type": "command", "command": "$CLAUDE_PROJECT_DIR/.venv/bin/tremula hook PreCompact" }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "$CLAUDE_PROJECT_DIR/.venv/bin/tremula hook SessionEnd" }] }
    ]
  }
}
